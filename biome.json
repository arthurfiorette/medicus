{
  "$schema": "https://biomejs.dev/schemas/latest/schema.json",
  "extends": ["@arthurfiorette/biomejs-config"],
  "assist": {
    "actions": {
      "source": {
        "useSortedPackageJson": "on"
      }
    }
  },
  "html": {
    "parser": {
      "interpolation": true
    }
  },
  "markdown": {
    "formatter": {
      "enabled": false
    }
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noConfusingVoidType": "off",
        "noTsIgnore": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [".serena/**"],
      "formatter": {
        "enabled": false
      },
      "linter": {
        "enabled": false
      }
    }
  ]
}
