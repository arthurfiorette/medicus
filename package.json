{
  "name": "medicus",
  "version": "1.5.0",
  "description": "Flexible, framework-agnostic health check library for Node.js and TypeScript. Liveness and readiness checks with Fastify, Hono, Avvio and plain HTTP integrations.",
  "keywords": [
    "health check",
    "healthcheck",
    "health-check",
    "health",
    "liveness",
    "readiness",
    "probe",
    "kubernetes",
    "k8s",
    "monitoring",
    "uptime",
    "heartbeat",
    "fastify",
    "fastify-plugin",
    "hono",
    "tanstack-start",
    "avvio",
    "pino",
    "node",
    "nodejs",
    "typescript",
    "diagnostics",
    "observability"
  ],
  "homepage": "https://medicus.js.org",
  "bugs": {
    "url": "https://github.com/arthurfiorette/medicus/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arthurfiorette/medicus.git"
  },
  "funding": "https://github.com/arthurfiorette/medicus?sponsor=1",
  "license": "MIT",
  "author": "Arthur Fiorette <me@arthur.place>",
  "contributors": [
    {
      "name": "Gabriel Alves",
      "email": "alv7contato@outlook.com",
      "url": "https://alvseven.com"
    }
  ],
  "sideEffects": false,
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./avvio": {
      "types": "./dist/integrations/avvio.d.ts",
      "default": "./dist/integrations/avvio.js"
    },
    "./fastify": {
      "types": "./dist/integrations/fastify.d.ts",
      "default": "./dist/integrations/fastify.js"
    },
    "./hono": {
      "types": "./dist/integrations/hono.d.ts",
      "default": "./dist/integrations/hono.js"
    },
    "./http": {
      "types": "./dist/integrations/http.d.ts",
      "default": "./dist/integrations/http.js"
    },
    "./node": {
      "types": "./dist/integrations/node.d.ts",
      "default": "./dist/integrations/node.js"
    },
    "./pino": {
      "types": "./dist/integrations/pino.d.ts",
      "default": "./dist/integrations/pino.js"
    },
    "./tanstack-start": {
      "types": "./dist/integrations/tanstack-start.d.ts",
      "default": "./dist/integrations/tanstack-start.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint-ci": "biome ci .",
    "lint-fix": "biome check --write --unsafe .",
    "prepack": "pnpm build",
    "prepare": "husky",
    "test": "c8 --reporter lcov --reporter text tsx --enable-source-maps --test \"test/**/*.test.ts\"",
    "test-types": "tsc --noEmit"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@arthurfiorette/biomejs-config": "^2.0.1",
    "@biomejs/biome": "^2.6.7",
    "@fastify/under-pressure": "^9.2.1",
    "@nolebase/vitepress-plugin-og-image": "^2.21.1",
    "@shikijs/vitepress-twoslash": "^4.6.0",
    "@tanstack/react-start": "^1.169.5",
    "@types/node": "^26.6.6",
    "c8": "^12.0.0",
    "close-with-grace": "^2.5.0",
    "hono": "^4.13.18",
    "husky": "^9.1.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4",
    "vitepress-plugin-llms": "^1.15.0"
  },
  "peerDependencies": {
    "avvio": "^9.3.0",
    "fastify": "^5.10.0",
    "fastify-plugin": "^6.0.0 || ^5.1.0",
    "hono": "^4.12.31",
    "pino": "^10.3.1"
  },
  "peerDependenciesMeta": {
    "avvio": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "fastify-plugin": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "pino": {
      "optional": true
    }
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "error",
      "version": ">=24.16"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
